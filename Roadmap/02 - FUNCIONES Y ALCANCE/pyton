def arg_greet(greet,name):
    print(f"{greet},{name}")

arg_greet("hi","Daniel")

def default_arg_greet(name="python"):
    print(f"hola,{name}")

default_arg_greet()
# con retorno y argumento

def return_arg_greet (greet,name):
    return f"{greet}, {name}"

print(arg_greet("hi","Daniel"))

#con retorno de varios valores

def multiple_return_greet():
    return "hola","python"
greet, name =multiple_return_greet()
print(greet)
print(name)

#con un numero variable de argumentos
def variable_arg_greet(*names):
    for name in names:
        print(f"hola,{name}" )

variable_arg_greet("python","dany", "mouredev","comunidad")

#con un numero variable de argumentos con palabra clave

def variable_new_arg_greet(**names):
    for param, name in names:
        print(f"hola,{name}, {param}" )

    variable_arg_greet(lenguaje="python",
                       nombre= "dany",
                       alias="Dany",
                       age=21)

